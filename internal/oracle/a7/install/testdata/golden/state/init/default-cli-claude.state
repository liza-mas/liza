<absent>
# after
version: 1
pipeline_version: 3
goal:
    id: goal-<ID>
    description: Oracle goal
    spec_ref: specs/vision.md
    created: <TIME>
    status: IN_PROGRESS
    alignment_history:
        - timestamp: <TIME>
          event: initialization
          summary: Initial goal. No tasks defined yet.
tasks: []
agents: {}
discovered: []
human_notes: []
spec_changes: []
anomalies: []
sprint:
    id: sprint-1
    number: 1
    goal_ref: goal-<ID>
    scope:
        planned: []
        stretch: []
    timeline:
        started: <TIME>
        deadline: <TIME>
    status: IN_PROGRESS
    metrics:
        planning_changes:
            daily: []
            unknown_attribution: 0
            missing_created: 0
        tasks_done: 0
        tasks_in_progress: 0
        tasks_blocked: 0
        iterations_total: 0
        review_cycles_total: 0
        review_verdict_approvals: 0
        review_verdict_rejections: 0
        review_verdict_count: 0
        review_verdict_approval_rate_percent: 0
        task_submitted_for_review_count: 0
        task_outcome_approval_rate_percent: 0
circuit_breaker:
    last_check: <TIME>
    status: OK
    history: []
config:
    terminal_task_archival: true
    max_coder_iterations: 10
    max_review_cycles: 5
    max_global_integration_generations: 3
    max_instances: 3
    heartbeat_interval: 60
    lease_duration: 1800
    coder_poll_interval: 30
    doer_max_wait: 600
    orchestrator_poll_interval: 60
    orchestrator_max_wait: 18000
    reviewer_poll_interval: 30
    reviewer_max_wait: 600
    agent_progress_timeout: 1800
    default_cli: claude
    integration_branch: integration
    mode: RUNNING
